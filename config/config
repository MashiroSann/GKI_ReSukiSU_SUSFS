# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=true

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效；留空表示跟随该分支最新提交
#
# 784ac9e6: 2026-11-15，gki-android12-5.10 分支 tip，selinux_hide 重写版。
#   新版不再由 KernelSU 侧维护 backup policy，而是在内核侧
#   security/selinux/{selinuxfs,hooks,ss/services}.c 编译期接管
#   /sys/fs/selinux/{access,context,status} 与 setprocattr，并依赖两张
#   "sus 注册表" 决定哪些 type / 规则属于 KSU 注入、需要对普通 app 隐藏。
#
#   11-15 那次构建失败的原因已定位：注册表是空的。
#   官方 KernelSU 由 kernel_patches/KernelSU/10_enable_susfs_for_ksu.patch
#   在 add_type()/add_rule_raw() 里打点；但 BakaSU 变体在构建流程里走
#   "使用内置 SUSFS 支持"分支，不会应用该补丁，于是注册表永远为空，
#   ksu_selinux_hide_running=1 也什么都藏不住（Duck 报 context oracle 11、
#   DirtySepolicy 边全部 Allowed）。现由 scripts/apply_susfs_sus_registry.py
#   在构建时补打这两个点。
#
#   另外 scripts/apply_selinux_timing_alignment.py 会把
#   susfs_selinux_setprocattr() 的前导换行剥掉，让 Duck 1110 新增的
#   app_zygote attr/current A/B 时序判据失去稳定的正时序差。
#
# 8930474a: 2026-10-29，旧版全量伪造 selinux_hide，作为回滚点保留备注。
gki-android12-5.10=784ac9e6fd49bb02499b5b60c57ccc9d0c680204
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== NoMount 的 commit hash ====================
# 仅当 custom=true 且 use_nomount=true 时生效；留空表示跟随 dev 分支最新提交
# 611f242: 2026-11-15，dev 分支最新（v2.3.0 之后的 nm 直调改造）
# 注意：NoMount 的内核驱动与 metamodule 必须版本匹配，
#       模块侧的 NoMount 版本需同步更新到 v2.3.0 或更新。
nomount=611f2420abfd49c716e7e1ca685a7b6143eb2cae

# ==================== BakaSU 的 commit hash ====================
# 仅当 custom=true 时生效；留空表示跟随 main 分支最新提交
#
# 252b152: BakaSU PR #662「sync with upstream」分支 sync-up 的 head（2026-11-14）。
#   该分支已包含新版 SUSFS 需要的 KernelSU 侧集成：
#     kernel/selinux/sepolicy.c: susfs_add_sus_type() / susfs_add_sus_avd_allowed_by_type()
#     kernel/feature/selinux_hide.c: 大改（+570/-107），含 parse setprocattr once 等修复
#   main 分支尚未合并该 PR；若合并后可切回 main 的提交。
#   注意：scripts/apply_susfs_sus_registry.py 检测到打点已存在会自动跳过，
#   所以 pin 回旧 main（548d1dd）时也能正常工作。
bakasu=252b15203940c00570c65c0d33db12d9e76c4dff

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=